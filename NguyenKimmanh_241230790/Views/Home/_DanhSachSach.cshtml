@model IEnumerable<NguyenKimmanh_241230790.Models.Sach>

@foreach (var item in Model)
{
    <div class="book-card">
        <a href="#">
            <img src="@Url.Content("~/images/" + item.Anh)"
                 alt="@item.TenSach" />
        </a>

        <h2>@item.TenSach</h2>

        <div class="book-foot">
            <span class="price">
                @(item.Gia?.ToString() ?? "Chưa có giá")
            </span>

            <button class="btn-buy">
                Thêm vào giỏ
            </button>
        </div>
    </div>
}
